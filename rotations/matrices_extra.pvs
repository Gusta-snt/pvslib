%----------------------------------------------------------------------------
% Extra lemmas about matrices
% Authors: Gustavo Ferreira dos Santos
% 	   Universidade Federal de Goiás - Brazil
%
%	   Thaynara Arielly de Lima
%	   Universidade Federal de Goiás - Brazil
%
% This theory contains extra lemmas for matrices theory.
%----------------------------------------------------------------------------

matrices_extra: THEORY

BEGIN
  IMPORTING 
    matrices@more_matrix_props


  % These theories, belonging to matrices@props_mat_vec_multiplication, 
  % must be modified according to the following specification.

  % @QED mult_scal_alt proved by gusta on Fri, 15 May 2026 12:21:20 GMT
  mult_scal_alt: LEMMA 
    FORALL(m, n: posnat, A: MatrixMN(m,n), v: VectorN(n), c: real):
      A * (c * v) = (c * A) * v

  % @QED mult_mat_zero_vec_alt proved by gusta on Fri, 15 May 2026 12:22:18 GMT
  mult_mat_zero_vec_alt: LEMMA 
    FORALL(m, n: posnat, A: MatrixMN(m,n)):
      A * zero_vec(n) = zero_vec(m)

END matrices_extra