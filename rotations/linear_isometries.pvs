%----------------------------------------------------------------------------
% Linear Isometries Lemmas
% Authors: Gustavo Ferreira dos Santos
% 	   Universidade Federal de Goiás - Brazil
%
%	   Thaynara Arielly de Lima
%	   Universidade Federal de Goiás - Brazil
%
% This theory contains lemmas and properties about linear isometries on R^n.
%----------------------------------------------------------------------------

linear_isometries[n: posnat]: THEORY

BEGIN

  IMPORTING linear_isometries_def[n]

  % Variables
  f, g: VAR Function_n
  x, y: VAR ConsVecN
  c: VAR ConsVecN
  norm: VAR (norm?(n))
  

  %--------------------------------------------------------------------------
  % Lemma 1.2: Relates isometry, fixing origin, and preserving lengths.
  %--------------------------------------------------------------------------
  
  % @QED isometry_fixes_origin_preserves_length proved by gusta on Fri, 13 Feb 2026 02:29:41 GMT
  isometry_fixes_origin_preserves_length: LEMMA
    isometry?(f)(norm) AND fixes_origin?(f) IMPLIES preserves_length?(f)(norm)

  % @QED linear_preserves_length_is_isometry proved by gusta on Fri, 13 Feb 2026 13:05:55 GMT
  linear_preserves_length_is_isometry: LEMMA
    linear?(f) AND preserves_length?(f)(norm) IMPLIES isometry?(f)(norm)

  %--------------------------------------------------------------------------
  % Lemma 1.3: Composition
  %--------------------------------------------------------------------------

  % @QED isometry_composition proved by gusta on Fri, 13 Feb 2026 13:14:59 GMT
  isometry_composition: LEMMA
    isometry?(f)(norm) AND isometry?(g)(norm) IMPLIES isometry?(f o g)(norm)

  % @QED linear_isometry_composition proved by gusta on Fri, 13 Feb 2026 13:18:10 GMT
  linear_isometry_composition: LEMMA
    linear_isometry?(f)(norm) AND linear_isometry?(g)(norm) IMPLIES linear_isometry?(f o g)(norm)

  %--------------------------------------------------------------------------
  % Lemma 1.4: Construction of linear isometry from general isometry
  %--------------------------------------------------------------------------

  % If f is an isometry, then g(x) = f(x) - f(0) is a linear isometry.
  % @QED isometry_shift_to_linear proved by gusta on Fri, 15 May 2026 11:16:50 GMT
  isometry_shift_to_linear: LEMMA
    isometry?(f)(norm) AND NOT fixes_origin?(f) IMPLIES
    LET g = (LAMBDA (x: ConsVecN): f(x) - f(zero_vec(n))) IN
    linear_isometry?(g)(norm)

END linear_isometries
